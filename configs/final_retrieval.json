      "source": "results/metrics/retrieval_dev_comparison.json"
    },
    {
      "chunker": "heading",
      "method": "hybrid",
      "source": "results/metrics/retrieval_dev_comparison.json"
    },
    {
      "chunker": "heading",
      "method": "hybrid+cross-encoder/ms-marco-MiniLM-L-6-v2",
      "source": "results/metrics/retrieval_dev_comparison.json"
    },
    {
      "chunker": "heading",
      "method": "hybrid+BAAI/bge-reranker-base",
