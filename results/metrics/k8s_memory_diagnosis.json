{
  "diagnosis_only": true,
  "no_changes": "no code, Dockerfile, Deployment, limits or HPA changed; LLM_STUB set to 1 for the measurements and back to 0 (verified)",
  "setup": {
    "requests": "20 sequential /ask requests (one at a time), cycling the 10 load-test questions; LLM_STUB=1 (no Groq calls)",
    "k8s": {
      "pod_limits": "cpu 2, memory 2.5Gi (2560 MiB)",
      "OMP_NUM_THREADS": "2",
      "nproc": 2,
      "cpu.max": "200000 100000",
      "torch.get_num_threads": 2,
      "torch.get_num_interop_threads": 10,
      "server_threads": 9,
      "access": "kubectl port-forward (1 replica)"
    },
    "docker": {
      "limits": "none (memory.max=max, cpu.max=max)",
      "OMP_NUM_THREADS": "unset",
      "nproc": 10,
      "torch.get_num_threads": 10,
      "access": "docker compose, port 8000"
    },
    "rerank_batch": {
      "candidates_per_request": 20,
      "predict_batch_size": "32 (CrossEncoder.predict default; the service does not pass one; rerank.py's BATCH_SIZE=32 is used only by the eval reranker)",
      "max_length": "512 (rerank.py MAX_LENGTH)",
      "padding": "to the longest pair in the batch",
      "measured_forward_input_shape": [
        20,
        512
      ],
      "forward_passes_per_request": 1
    },
    "reranker_model": {
      "name": "BAAI/bge-reranker-base",
      "architecture": "xlm-roberta, 12 layers, hidden 768, 12 heads, ffn 3072",
      "params_m": 278,
      "dtype": "float32",
      "weights_fp32_mib": 1061
    }
  },
